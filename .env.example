# AI Team OS 环境变量模板（005 5.1）
# 只写占位符，不得放真实密钥。API Key 只从环境变量读取。

# 模型 Provider
AI_TEAM_MODEL_PROVIDER=openai_compatible
AI_TEAM_MODEL_BASE_URL=https://api.example.com/v1
AI_TEAM_MODEL_API_KEY=SK-PLACEHOLDER-replace-me
AI_TEAM_MODEL_DEFAULT=gpt-4o-mini
AI_TEAM_MODEL_SUPERVISOR=
AI_TEAM_MODEL_PLANNER=
AI_TEAM_MODEL_RESEARCHER=
AI_TEAM_MODEL_REVIEWER=
AI_TEAM_MODEL_EXECUTOR=
AI_TEAM_MODEL_TIMEOUT_SECONDS=60
AI_TEAM_MODEL_MAX_RETRIES=2
AI_TEAM_MODEL_TEMPERATURE=0
AI_TEAM_MODEL_MAX_OUTPUT_TOKENS=4096
AI_TEAM_MODEL_ENABLE_REAL=false
