# ===== Model Gateway（OpenAI-compatible）=====
# M1 默认使用 DeterministicFakeModel（MODEL_FAKE=true），无需真实密钥。
# 真实 Provider 仅保留接口定义，不作为 M1 验收条件。
MODEL_FAKE=true
# OPENAI_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ===== 运行 =====
# 审计日志与 checkpoint 目录（默认 ./data）
# DATA_DIR=./data

# ===== 预算默认值（可由 CLI/API 覆盖）=====
# DEFAULT_TOKEN_BUDGET=100000
# DEFAULT_COST_BUDGET=1.0
